---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const breadcrumbs = [
  { label: 'Tools', href: '/tools/' },
  { label: 'Ecommerce Terminology Quiz' }
];

const quizQuestions = [
  {
    id: 1,
    question: 'Where should inventory stock quantities be stored when a product has multiple option combinations (e.g. Size/Color)?',
    options: [
      'On the top-level Product record',
      'On the individual Product Variant record',
      'In the Category model',
      'Directly inside the shopping cart session'
    ],
    correctIndex: 1,
    explanation: 'Inventory is tracked at the Variant level because physical stock is assigned to specific size and color choices, not abstract parent products.'
  },
  {
    id: 2,
    question: 'What is the primary difference between a SKU and a Barcode (UPC/EAN)?',
    options: [
      'SKUs are global while Barcodes are internal',
      'SKUs are internal to a merchant while Barcodes are global standards (GS1)',
      'Barcodes contain letters while SKUs are numbers only',
      'They are identical terms for the same number'
    ],
    correctIndex: 1,
    explanation: 'SKUs are created internally by merchants for warehouse tracking. Barcodes (UPC/EAN) are assigned globally by GS1 and are universal across all retailers.'
  },
  {
    id: 3,
    question: 'If a merchant buys an item for $40 (COGS) and sells it for $100, what is the Gross Profit Margin?',
    options: [
      '150%',
      '60%',
      '40%',
      '2.5%'
    ],
    correctIndex: 1,
    explanation: 'Gross Margin = (Selling Price - Cost) / Selling Price = (100 - 40) / 100 = 60%. Markup would be 150%!'
  },
  {
    id: 4,
    question: 'Why must historical unit prices be frozen inside Order Line Items at checkout?',
    options: [
      'To prevent database indexing errors',
      'Because live catalog product prices change over time and receipt records must remain immutable',
      'To allow payment gateways to modify card balances',
      'It is not necessary; live product links are preferred'
    ],
    correctIndex: 1,
    explanation: 'Order receipts are legal/financial contracts that must preserve exact historical prices paid at purchase time, even if catalog prices change later.'
  }
];
---

<BaseLayout
  title="Ecommerce Terminology Quiz — Test Your Knowledge"
  description="Test your developer knowledge of ecommerce domain logic, SKUs, variants, margins, and order architectures."
>
  <div class="container page-padding">
    <Breadcrumbs items={breadcrumbs} />

    <header class="tool-header">
      <span class="badge badge-ecommerce">Interactive Quiz</span>
      <h1>Ecommerce Terminology Quiz</h1>
      <p class="tool-subtitle">
        Test your domain knowledge on ecommerce business logic, database design, and platform terminology.
      </p>
    </header>

    <div id="quiz-container" class="quiz-container">
      {quizQuestions.map((q, index) => (
        <div class="quiz-card" data-question={index}>
          <div class="question-header">
            <span class="q-number font-mono">Question {index + 1} of {quizQuestions.length}</span>
            <h2 class="q-title">{q.question}</h2>
          </div>

          <div class="options-list">
            {q.options.map((opt, optIdx) => (
              <button
                type="button"
                class="option-btn"
                data-q={index}
                data-opt={optIdx}
                data-correct={optIdx === q.correctIndex ? 'true' : 'false'}
              >
                <span class="opt-letter font-mono">{String.fromCharCode(65 + optIdx)}</span>
                <span class="opt-text">{opt}</span>
              </button>
            ))}
          </div>

          <div class="explanation-box hidden" id={`exp-${index}`}>
            <p class="exp-result font-mono"></p>
            <p class="exp-text">{q.explanation}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .page-padding {
    padding-top: var(--space-8);
    padding-bottom: var(--space-16);
  }

  .tool-header h1 {
    font-size: var(--fs-3xl);
    margin-top: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .tool-subtitle {
    font-size: var(--fs-lg);
    color: var(--color-text-subtle);
    max-width: 640px;
    margin-bottom: var(--space-12);
  }

  .quiz-container {
    max-width: 760px;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .quiz-card {
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    box-shadow: var(--shadow-sm);
  }

  .question-header {
    margin-bottom: var(--space-6);
  }

  .q-number {
    font-size: var(--fs-xs);
    color: var(--color-primary);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .q-title {
    font-size: var(--fs-xl);
    margin-top: var(--space-2);
    margin-bottom: 0;
  }

  .options-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .option-btn {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    background-color: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    text-align: left;
    cursor: pointer;
    transition: all var(--transition-fast);
    font-size: var(--fs-base);
    color: var(--color-text-main);
  }

  .option-btn:hover {
    border-color: var(--color-primary);
    background-color: var(--color-primary-light);
  }

  .option-btn.selected-correct {
    background-color: var(--color-cro-light);
    border-color: var(--color-cro);
    color: var(--color-cro);
  }

  .option-btn.selected-incorrect {
    background-color: var(--color-warning-light);
    border-color: var(--color-warning);
    color: var(--color-warning);
  }

  .opt-letter {
    font-weight: 700;
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    width: 1.75rem;
    height: 1.75rem;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--fs-xs);
  }

  .explanation-box {
    background-color: var(--color-bg-subtle);
    border-left: 4px solid var(--color-primary);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-6);
  }

  .explanation-box.hidden {
    display: none;
  }

  .exp-result {
    font-weight: 700;
    font-size: var(--fs-sm);
    margin-bottom: var(--space-1);
  }

  .exp-text {
    font-size: var(--fs-sm);
    color: var(--color-text-subtle);
    margin: 0;
  }
</style>

<script>
  const optionBtns = document.querySelectorAll<HTMLButtonElement>('.option-btn');

  optionBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const qIdx = btn.getAttribute('data-q');
      const isCorrect = btn.getAttribute('data-correct') === 'true';
      const expBox = document.getElementById(`exp-${qIdx}`);

      // Disable sibling buttons for this question
      const siblings = document.querySelectorAll<HTMLButtonElement>(`.option-btn[data-q="${qIdx}"]`);
      siblings.forEach((s) => (s.disabled = true));

      if (isCorrect) {
        btn.classList.add('selected-correct');
        if (expBox) {
          expBox.classList.remove('hidden');
          const res = expBox.querySelector('.exp-result');
          if (res) {
            res.textContent = '✅ Correct!';
            (res as HTMLElement).style.color = 'var(--color-cro)';
          }
        }
      } else {
        btn.classList.add('selected-incorrect');
        // Highlight correct answer
        siblings.forEach((s) => {
          if (s.getAttribute('data-correct') === 'true') {
            s.classList.add('selected-correct');
          }
        });
        if (expBox) {
          expBox.classList.remove('hidden');
          const res = expBox.querySelector('.exp-result');
          if (res) {
            res.textContent = '❌ Incorrect';
            (res as HTMLElement).style.color = 'var(--color-warning)';
          }
        }
      }
    });
  });
</script>
