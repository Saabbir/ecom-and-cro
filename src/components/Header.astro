---
const pathname = Astro.url.pathname;

function isActive(path: string) {
  if (path === '/') return pathname === '/';
  // Normalize paths to remove trailing slashes for comparison
  const normPath = path.replace(/\/$/, '');
  const normPathname = pathname.replace(/\/$/, '');
  return normPathname.startsWith(normPath);
}

const navItems = [
  { label: 'Learning Paths', href: '/paths/' },
  { label: 'Ecommerce', href: '/ecommerce/' },
  { label: 'Comparisons', href: '/compare/' },
  { label: 'Shopify', href: '/shopify/' },
  { label: 'Metrics', href: '/metrics/' },
  { label: 'CRO', href: '/cro/' },
  { label: 'Tools', href: '/tools/' }
];
---

<header class="site-header">
  <div class="container header-content">
    <a href="/" class="site-logo">
      <span class="logo-icon">⚡</span>
      <span class="logo-text">
        <span class="logo-full">Ecom <span>&</span> CRO</span>
        <span class="logo-short">ECRO</span>
      </span>
      <span class="logo-tag font-mono">dev</span>
    </a>

    <nav class="desktop-nav" aria-label="Main Navigation">
      {navItems.map((item) => {
        const active = isActive(item.href);
        return (
          <a
            href={item.href}
            class={`nav-link ${active ? 'active' : ''}`}
            aria-current={active ? 'page' : undefined}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <div class="header-actions">
      <button type="button" class="search-trigger-btn" id="open-search-btn" aria-label="Search concepts (Cmd+K)">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <span class="search-placeholder">Search...</span>
        <kbd class="search-kbd">⌘K</kbd>
      </button>

      <button type="button" class="theme-toggle-btn" id="theme-toggle" aria-label="Toggle light and dark mode">
        <svg class="sun-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
        <svg class="moon-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
      </button>

      <button type="button" class="mobile-toggle-btn" id="mobile-toggle" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="mobile-dropdown">
        <svg class="hamburger-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
        <svg class="close-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>
  </div>

  <div class="mobile-dropdown" id="mobile-dropdown">
    <nav class="mobile-nav" aria-label="Mobile Navigation">
      {navItems.map((item) => {
        const active = isActive(item.href);
        return (
          <a
            href={item.href}
            class={`mobile-nav-link ${active ? 'active' : ''}`}
            aria-current={active ? 'page' : undefined}
          >
            <span class="mobile-link-text">{item.label}</span>
            <span class="mobile-link-arrow">&rarr;</span>
          </a>
        );
      })}
    </nav>
  </div>
</header>

<style>
  .site-header {
    background-color: var(--color-bg-surface);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(8px);
  }

  .header-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height);
    width: 100%;
  }

  .site-logo {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 700;
    font-size: var(--fs-md);
    color: var(--color-text-main);
    text-decoration: none;
    flex-shrink: 0;
  }

  .site-logo:hover {
    text-decoration: none;
  }

  .logo-icon {
    font-size: 1.25rem;
  }

  .logo-text span {
    color: var(--color-primary);
  }

  .logo-short {
    display: none;
  }

  .logo-tag {
    font-size: var(--fs-xs);
    background-color: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    color: var(--color-text-subtle);
    padding: 0.1rem 0.4rem;
    border-radius: var(--radius-sm);
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .nav-link {
    position: relative;
    color: var(--color-text-muted);
    font-size: var(--fs-sm);
    font-weight: 500;
    text-decoration: none;
    padding: 0.5rem 0;
    transition: color var(--transition-fast);
  }

  .nav-link:hover {
    color: var(--color-primary);
    text-decoration: none;
  }

  .nav-link.active {
    color: var(--color-primary);
    font-weight: 700;
  }

  .nav-link.active::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background-color: var(--color-primary);
    border-radius: var(--radius-full);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .search-trigger-btn {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    background-color: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    color: var(--color-text-subtle);
    padding: 0.4rem 0.75rem;
    border-radius: var(--radius-md);
    cursor: pointer;
    font-size: var(--fs-sm);
    transition: all var(--transition-fast);
  }

  .search-trigger-btn:hover {
    border-color: var(--color-border-strong);
    color: var(--color-text-main);
  }

  .search-kbd {
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    padding: 0.1rem 0.35rem;
    border-radius: var(--radius-sm);
    font-size: var(--fs-xs);
    font-family: var(--font-mono);
  }

  .theme-toggle-btn {
    background: transparent;
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .theme-toggle-btn:hover {
    background-color: var(--color-bg-subtle);
    color: var(--color-text-main);
  }

  .moon-icon { display: none; }

  :global([data-theme="dark"]) .sun-icon { display: none; }
  :global([data-theme="dark"]) .moon-icon { display: block; }

  /* Mobile Hamburger Toggle Button */
  .mobile-toggle-btn {
    display: none;
    background: transparent;
    border: 1px solid var(--color-border);
    color: var(--color-text-main);
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-md);
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .mobile-toggle-btn:hover {
    background-color: var(--color-bg-subtle);
  }

  .mobile-toggle-btn .close-icon {
    display: none;
  }

  .mobile-toggle-btn[aria-expanded="true"] .hamburger-icon {
    display: none;
  }

  .mobile-toggle-btn[aria-expanded="true"] .close-icon {
    display: block;
  }

  /* Mobile Dropdown Menu */
  .mobile-dropdown {
    display: none;
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease-in-out, padding 0.3s ease-in-out;
    background-color: var(--color-bg-surface);
    border-top: 1px solid var(--color-border);
    padding: 0 1rem;
  }

  .mobile-dropdown.is-open {
    display: block;
    max-height: 400px;
    padding: 0.75rem 1rem 1.25rem 1rem;
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    min-height: 48px;
    border-radius: var(--radius-md);
    color: var(--color-text-main);
    font-weight: 500;
    text-decoration: none;
    font-size: var(--fs-base);
    transition: background-color var(--transition-fast);
  }

  .mobile-nav-link:hover {
    background-color: var(--color-bg-subtle);
    color: var(--color-primary);
  }

  .mobile-nav-link.active {
    background-color: var(--color-primary-light);
    color: var(--color-primary);
    font-weight: 700;
  }

  .mobile-link-arrow {
    color: var(--color-text-subtle);
    font-size: 0.9rem;
  }

  .mobile-nav-link.active .mobile-link-arrow {
    color: var(--color-primary);
  }

  /* Responsive Media Queries */
  @media (max-width: 900px) {
    .desktop-nav {
      display: none;
    }
    .mobile-toggle-btn {
      display: flex;
    }
  }

  @media (max-width: 520px) {
    .logo-tag {
      display: none; /* Hide dev badge on small mobile viewports */
    }
    .logo-full {
      display: none; /* Hide long logo text */
    }
    .logo-short {
      display: inline; /* Show short ECRO logo */
    }
    .search-placeholder, .search-kbd {
      display: none; /* Show icon-only search button */
    }
    .search-trigger-btn {
      padding: 0.4rem 0.5rem;
    }
  }
</style>

<script>
  // Theme Toggle Logic
  const toggleBtn = document.getElementById('theme-toggle');
  
  function getThemePreference(): string {
    if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
      return localStorage.getItem('theme') || 'light';
    }
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }

  function setTheme(theme: string) {
    document.documentElement.setAttribute('data-theme', theme);
    localStorage.setItem('theme', theme);
  }

  setTheme(getThemePreference());

  toggleBtn?.addEventListener('click', () => {
    const currentTheme = document.documentElement.getAttribute('data-theme');
    const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
    setTheme(newTheme);
  });

  // Mobile Menu Toggle Logic
  const mobileToggle = document.getElementById('mobile-toggle');
  const mobileDropdown = document.getElementById('mobile-dropdown');

  if (mobileToggle && mobileDropdown) {
    mobileToggle.addEventListener('click', () => {
      const expanded = mobileToggle.getAttribute('aria-expanded') === 'true';
      mobileToggle.setAttribute('aria-expanded', String(!expanded));
      mobileDropdown.classList.toggle('is-open');
    });

    // Close mobile menu on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && mobileDropdown.classList.contains('is-open')) {
        mobileToggle.setAttribute('aria-expanded', 'false');
        mobileDropdown.classList.remove('is-open');
      }
    });

    // Close mobile menu when clicking any mobile nav link
    const mobileLinks = mobileDropdown.querySelectorAll('a');
    mobileLinks.forEach((link) => {
      link.addEventListener('click', () => {
        mobileToggle.setAttribute('aria-expanded', 'false');
        mobileDropdown.classList.remove('is-open');
      });
    });
  }
</script>
